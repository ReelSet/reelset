DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# Vercel cannot reach Supabase's IPv6-only direct host; switch DATABASE_URL to the transaction pooler there:
# postgresql://postgres.<project-ref>:<password>@aws-1-us-west-2.pooler.supabase.com:6543/postgres
LOG_LEVEL=debug
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
MEDIA_PUBLIC_BASE_URL=https://media.reelset.app
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
HYPERDRIVE_ID=
GEMINI_API_KEY=
CLAUDE_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GITHUB_TOKEN=
ALERT_WEBHOOK_URL=
# Comma-separated emails auto-promoted to admin on login (web)
ADMIN_EMAILS=
# Host that serves /admin (default admin.reelset.app)
ADMIN_HOST=
