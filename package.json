{
  "name": "reelset",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "workers/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "db:generate": "npm run db:generate -w @reelset/core",
    "db:deploy": "npm run db:deploy -w @reelset/core",
    "db:check": "npm run db:check -w @reelset/core"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
