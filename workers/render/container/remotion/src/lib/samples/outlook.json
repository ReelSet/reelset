{
  "durationSeconds": 49.388,
  "title": "Outlook.com Is Quietly Rejecting Email from Domains Without DMARC",
  "source": "hn",
  "sourceLabel": "Hacker News",
  "domain": "mailroute.net",
  "scenes": [
    {
      "kind": "hook",
      "start": 0.0,
      "end": 4.8,
      "text": "Outlook.com is quietly rejecting emails from domains without DMARC records."
    },
    {
      "kind": "beat",
      "start": 4.8,
      "end": 19.785,
      "text": "Since November 5, 2026, Microsoft's consumer mail service has been rejecting emails. This affects mail to outlook.com, hotmail.com, live.com, or msn.com addresses if your domain lacks DMARC.",
      "visual": { "type": "stat", "label": "Emails Rejected Since", "value": "Nov 5, 2026" },
      "shots": [
        {
          "at": "addresses",
          "show": "KeyPoint",
          "props": { "text": "Affects @outlook.com, @hotmail.com, @live.com, @msn.com" },
          "t": 17.305
        }
      ]
    },
    {
      "kind": "beat",
      "start": 19.785,
      "end": 26.985,
      "text": "This change was unannounced, causing problems for many. Developers and companies are now scrambling to mitigate bounced emails.",
      "visual": { "type": "quote", "text": "Nobody announced it.", "attribution": "mailroute.net" },
      "shots": [
        {
          "at": "unannounced",
          "show": "KeyPoint",
          "props": { "text": "No Official Announcement" },
          "t": 20.745
        },
        {
          "at": "bounced",
          "show": "KeyPoint",
          "props": { "text": "Emails are Bouncing" },
          "t": 25.865
        }
      ]
    },
    {
      "kind": "beat",
      "start": 26.985,
      "end": 35.01,
      "text": "DMARC prevents spoofing, phishing, and business email compromise. Authenticated domains are much harder to impersonate.",
      "visual": {
        "type": "title",
        "title": "Why DMARC Matters",
        "subtitle": "Prevents email fraud"
      },
      "shots": [
        {
          "at": "spoofing",
          "show": "KeyPoint",
          "props": { "text": "Prevents Spoofing & Phishing" },
          "t": 28.105
        },
        {
          "at": "impersonate",
          "show": "KeyPoint",
          "props": { "text": "Authenticates Your Domain" },
          "t": 34.05
        }
      ]
    },
    {
      "kind": "beat",
      "start": 35.01,
      "end": 42.13,
      "text": "The fix is one DNS record. DMARC passes if SPF or DKIM aligns with your From address domain.",
      "visual": { "type": "code", "language": "dns", "code": "v=DMARC1; p=none;" },
      "shots": [
        {
          "at": "DNS",
          "show": "CodeBlock",
          "props": { "code": "v=DMARC1; p=none;", "language": "dns" },
          "t": 35.97
        },
        {
          "at": "aligns",
          "show": "KeyPoint",
          "props": { "text": "Requires SPF or DKIM Alignment" },
          "t": 39.73
        }
      ]
    },
    {
      "kind": "outro",
      "start": 42.13,
      "end": 49.388,
      "text": "DMARC at p=none is now the baseline for major mailbox providers. Add your DMARC record today."
    }
  ],
