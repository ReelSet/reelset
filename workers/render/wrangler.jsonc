{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reelset-render",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "ReelContainer",
      "image": "./container/Dockerfile",
      "instance_type": "standard-3",
      "max_instances": 3,
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "REEL_CONTAINER", "class_name": "ReelContainer" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ReelContainer"] }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "reelset-media" }],
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "cf0f4b14f2394a58a23e8241137c45a4" }],
  "queues": {
    "producers": [{ "queue": "render-jobs", "binding": "RENDER_JOBS" }],
    "consumers": [
      {
        "queue": "render-jobs",
        "max_batch_size": 3,
        "max_concurrency": 2,
        "max_retries": 3,
        "dead_letter_queue": "render-jobs-dlq",
      },
    ],
  },
  "triggers": { "crons": ["*/10 * * * *"] },
  "vars": { "TTS_VOICE": "en-US-AriaNeural" },
}
