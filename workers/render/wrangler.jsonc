{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reelset-render",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "render-api.reelset.app", "custom_domain": true }],
  "observability": { "enabled": true },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ReelContainer"] },
    { "tag": "v2", "deleted_classes": ["ReelContainer"] },
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "reelset-media" }],
  "ai": { "binding": "AI" },
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "cf0f4b14f2394a58a23e8241137c45a4" }],
  "queues": {
    "producers": [
      { "queue": "render-jobs", "binding": "RENDER_JOBS" },
      { "queue": "instagram-run", "binding": "IG_RUN" },
    ],
    "consumers": [
      {
        "queue": "render-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 2,
        "max_concurrency": 1,
        "max_retries": 8,
        "dead_letter_queue": "render-jobs-dlq",
      },
      {
        "queue": "instagram-run",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_concurrency": 1,
        "max_retries": 0,
      },
    ],
  },
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "TTS_VOICE": "en-US-AriaNeural",
    "RENDER_BOX_URL": "https://box1.reelset.app",
    "HELPER_BOX_URL": "https://box2.reelset.app",
  },
}
